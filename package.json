{
  "name": "crimson-music-mobile",
  "description": "An open-source Audius music client for iOS, Android, and the web, built with Expo and React Native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stefan-Mihajlovic/Crimson-Music.git"
  },
  "homepage": "https://github.com/Stefan-Mihajlovic/Crimson-Music#readme",
  "bugs": {
    "url": "https://github.com/Stefan-Mihajlovic/Crimson-Music/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "audius",
    "music",
    "expo",
    "react-native",
    "ios",
    "android",
    "web"
  ],
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "jest --runInBand",
    "test:unit": "node --test tests/*.test.mjs",
    "postinstall": "node scripts/fix-expo-ios-paths.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo prebuild --platform ios && node scripts/fix-expo-ios-paths.js && expo run:ios --device --configuration Release --no-install",
    "ios:device:dev": "expo prebuild --platform ios && node scripts/fix-expo-ios-paths.js && expo run:ios --device --configuration Debug --no-install",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "overrides": {
    "qs": "^6.16.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-audio"]
      }
    }
  },
  "private": true
}
