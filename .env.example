# Required public Audius app identity, used only as the OAuth client ID.
# Register the native redirect URL: crimsonmusic://oauth/callback
# Music/library requests authenticate with the signed-in listener's bearer token.
# Never put a private API secret here.
# Listener access and refresh tokens are obtained at sign-in, not from this file.
EXPO_PUBLIC_AUDIUS_API_KEY=

# Optional Sentry project Client Key (DSN). Reporting is disabled when empty.
EXPO_PUBLIC_SENTRY_DSN=
# Source-map upload credentials belong in private build secrets:
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT

# Optional native build configuration for contributors and forks.
# Leave empty to let Xcode select a signing team and retain app.json identifiers.
# These are build settings, not credentials. Never add a signing key to this file.
IOS_APPLE_TEAM_ID=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
